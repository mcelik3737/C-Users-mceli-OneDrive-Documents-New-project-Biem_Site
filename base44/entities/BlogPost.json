{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Yaz\u0131 ba\u015fl\u0131\u011f\u0131"
    },
    "slug": {
      "type": "string",
      "description": "URL dostu k\u0131sa isim (\u00f6rn: tetra-sistemleri-nedir)"
    },
    "category": {
      "type": "string",
      "enum": [
        "teknik-makale",
        "proje-hikayesi",
        "sektor-haberi"
      ],
      "description": "Kategori"
    },
    "summary": {
      "type": "string",
      "description": "K\u0131sa \u00f6zet (liste g\u00f6r\u00fcn\u00fcm\u00fcnde g\u00f6sterilir)"
    },
    "content": {
      "type": "string",
      "description": "Yaz\u0131 i\u00e7eri\u011fi (markdown destekli)"
    },
    "cover_image": {
      "type": "string",
      "description": "Kapak g\u00f6rseli URL"
    },
    "author": {
      "type": "string",
      "description": "Yazar ad\u0131"
    },
    "published": {
      "type": "boolean",
      "default": false,
      "description": "Yay\u0131nda m\u0131?"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Etiketler"
    }
  },
  "required": [
    "title",
    "category",
    "summary",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
